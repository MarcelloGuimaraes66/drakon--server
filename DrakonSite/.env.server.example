# Runtime profile: server
PORT=4999
STORAGE_ROOT=./storage
APP_BASE_URL=https://drakon-solution.com
APP_ALLOWED_ORIGINS=https://drakon-solution.com,https://www.drakon-solution.com
R2_PUBLIC_BASE_URL=https://drakon-solution.com/media

# Postgres
PGHOST=localhost
PGPORT=5433
PGDATABASE=perceptrum_site
PGUSER=postgres
PGPASSWORD=change_me

# Stripe (production mode)
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CHAT_PAYG_PRICE_ID=price_replace_me

# Optional
USD_TO_BRL=5.0
SCHEDULER_TICK_SECRET=change_me
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://perceptrum.ai/auth/callback
# International postal-code lookup (non-BR). Brazil continues to use ViaCEP.
GEONAMES_USERNAME=
GOOGLE_GEOCODING_API_KEY=

# Optional central identity server/client
CENTRAL_AUTH_BASE_URL=
CENTRAL_AUTH_PUBLIC_KEY=
CENTRAL_AUTH_PRIVATE_KEY=
CENTRAL_AUTH_PUBLIC_KEY_PATH=
CENTRAL_AUTH_PRIVATE_KEY_PATH=
CENTRAL_AUTH_GRANT_TTL_HOURS=72
CENTRAL_AUTH_KEY_ID=central-auth-v1

# Frontend (Vite)
VITE_DISABLE_WS=true
