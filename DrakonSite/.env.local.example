# Runtime profile: local
PORT=4000
STORAGE_ROOT=./storage
APP_BASE_URL=http://localhost:4000
APP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4000
R2_PUBLIC_BASE_URL=http://localhost:4000/media

# Postgres
# Do not place remote production Postgres credentials here for the desktop app.
PGHOST=localhost
PGPORT=5433
PGDATABASE=perceptrum_site
PGUSER=postgres
PGPASSWORD=1234

# Database backend
# auto => sqlite for brand.txt=perceptrum, postgres for brand.txt=drakon
APP_DB_BACKEND=auto
# SQLITE_DB_PATH=

# Stripe (test mode)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CHAT_PAYG_PRICE_ID=price_replace_me

# Optional
USD_TO_BRL=5.0
SCHEDULER_TICK_SECRET=dev-secret
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/auth/callback
GOOGLE_GEOCODING_API_KEY=

# Optional central identity client
CENTRAL_AUTH_BASE_URL=
CENTRAL_AUTH_PUBLIC_KEY=
CENTRAL_AUTH_PUBLIC_KEY_PATH=
CENTRAL_AUTH_GRANT_TTL_HOURS=72
CENTRAL_AUTH_KEY_ID=central-auth-v1

# Frontend (Vite)
VITE_DISABLE_WS=true
