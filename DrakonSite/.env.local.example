# Runtime profile: local
PORT=4000
STORAGE_ROOT=./storage
APP_BASE_URL=http://localhost:4000
APP_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4000
R2_PUBLIC_BASE_URL=http://localhost:4000/media

# Postgres
# Do not place remote production Postgres credentials here for the desktop app.
PGHOST=localhost
PGPORT=5433
PGDATABASE=perceptrum_site
PGUSER=postgres
PGPASSWORD=1234

# Database backend
# auto => sqlite for brand.txt=perceptrum, postgres for brand.txt=drakon
APP_DB_BACKEND=auto
# SQLITE_DB_PATH=

# Stripe (test mode)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_CHAT_PAYG_PRICE_ID=price_replace_me

# Optional
USD_TO_BRL=5.0
SCHEDULER_TICK_SECRET=dev-secret
# Web/local browser OAuth client (used by the dev web app)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/auth/callback
# Optional desktop/native OAuth client for a dedicated packaged-app callback
DESKTOP_GOOGLE_OAUTH_CLIENT_ID=
# Optional for Google Desktop App clients that support PKCE without a secret
DESKTOP_GOOGLE_OAUTH_CLIENT_SECRET=
# Leave blank to use the web callback flow unless a desktop client ID is configured
DESKTOP_GOOGLE_OAUTH_REDIRECT_URI=
# International postal-code lookup (non-BR). Brazil continues to use ViaCEP.
GEONAMES_USERNAME=
GOOGLE_GEOCODING_API_KEY=

# Optional central identity client
# For installed desktop clients, prefer:
# ~/.config/Perceptrum/central-auth-client.env
# or set CENTRAL_AUTH_CLIENT_ENV_FILE=/absolute/path/to/central-auth-client.env
CENTRAL_AUTH_BASE_URL=
CENTRAL_AUTH_PUBLIC_KEY=
CENTRAL_AUTH_PUBLIC_KEY_PATH=
CENTRAL_AUTH_GRANT_TTL_HOURS=72
CENTRAL_AUTH_KEY_ID=central-auth-v1

# Frontend (Vite)
VITE_DISABLE_WS=true

# Service-cpp daily snapshots (one per active camera per local day)
DAILY_REPORTS=false
