    "scripts": {
        "build": "tsc -b && vite build",
        "cf-typegen": "wrangler types",
        "check": "tsc && vite build && wrangler deploy --dry-run",
        "db:sqlite:import-perceptrum": "node ./scripts/convert-postgres-dump-to-sqlite.mjs --brand perceptrum --users local:1,local:3,local:5,local:6",
        "dev": "vite",
        "deploy:server": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/deploy-server.ps1",
        "deploy:server:post": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/deploy-post.ps1",
        "deploy:central-auth": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/deploy-central-auth.ps1",
        "deploy:central-auth:post": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/deploy-central-auth-post.ps1",
        "keys:central-auth": "node ./scripts/generate-central-auth-keypair.mjs",
        "lint": "eslint .",
        "dev:server": "tsx --tsconfig tsconfig.worker.json server/index.ts",
        "prebuild": "node ../branding/apply-brand.mjs",
        "precheck": "node ../branding/apply-brand.mjs",
        "predev": "node ../branding/apply-brand.mjs",
        "predev:server": "node ../branding/apply-brand.mjs"
    }
