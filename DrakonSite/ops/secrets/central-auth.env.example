ENV_PROFILE=server
NODE_ENV=production

# Dedicated central-auth backend listener
PORT=6999
APP_RUNTIME_ENV=server
APP_DB_BACKEND=postgres
APP_SCHEMA_SCOPE=identity-only

# Central auth server can live behind its own subdomain/reverse proxy.
APP_BASE_URL=https://auth.perceptrum.ai
APP_ALLOWED_ORIGINS=https://app.perceptrum.ai,https://perceptrum.ai
R2_PUBLIC_BASE_URL=https://auth.perceptrum.ai/media

# Google audiences accepted by central identity when syncing Google logins
GOOGLE_OAUTH_CLIENT_ID=
DESKTOP_GOOGLE_OAUTH_CLIENT_ID=

# Remote Postgres: keep these values only on the Linux server.
PGHOST=172.233.186.23
PGPORT=5432
PGDATABASE=perceptrum_server
PGUSER=postgres
PGPASSWORD=change_me

# Central identity signing. Prefer file paths over inline multiline PEMs.
CENTRAL_AUTH_PUBLIC_KEY_PATH=/etc/perceptrum/keys/central-auth-public.pem
CENTRAL_AUTH_PRIVATE_KEY_PATH=/etc/perceptrum/keys/central-auth-private.pem
CENTRAL_AUTH_KEY_ID=central-auth-v1
CENTRAL_AUTH_GRANT_TTL_HOURS=72

# Optional runtime knobs
STORAGE_ROOT=/var/www/perceptrum-central-auth/storage
SCHEDULER_TICK_SECRET=change_me
USD_TO_BRL=5.0
