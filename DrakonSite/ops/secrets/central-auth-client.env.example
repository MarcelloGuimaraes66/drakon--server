# Perceptrum desktop/client central identity configuration.
# Copy this file to the local desktop config root, not to the source tree:
#
#   Linux:   ~/.config/Perceptrum/central-auth-client.env
#   macOS:   ~/Library/Application Support/Perceptrum/central-auth-client.env
#   Windows: %APPDATA%\\Perceptrum\\central-auth-client.env
#
# This client file must contain only the central identity public/client values.
# Do not put CENTRAL_AUTH_PRIVATE_KEY here.

CENTRAL_AUTH_BASE_URL=https://auth.perceptrum.example
CENTRAL_AUTH_PUBLIC_KEY_PATH=/home/USER/.config/Perceptrum/central-auth-public.pem
CENTRAL_AUTH_GRANT_TTL_HOURS=72
CENTRAL_AUTH_KEY_ID=central-auth-v1
