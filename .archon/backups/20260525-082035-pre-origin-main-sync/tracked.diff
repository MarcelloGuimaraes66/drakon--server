+void PairingClient::logDebug(std::string_view message) const
+{
+    if (options_.logger != nullptr) {
+        options_.logger->debug("agent", message);
+        return;
+    }
+
+#ifndef PERCEPTRUM_LINUX_BUILD
+    Logger::instance().logDebug("agent", std::string(message));
