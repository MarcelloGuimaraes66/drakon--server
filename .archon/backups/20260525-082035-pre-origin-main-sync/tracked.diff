+      method,
+      headers,
+      body,
+    }),
+    env as any,
+    { waitUntil: () => {} } as any
+  );
+}
+
+async function writeWorkerFetchResponse(res: any, response: Response) {
+  res.statusCode = response.status;
+  response.headers.forEach((value, key) => {
+    res.setHeader(key, value);
+  });
+
+  if (response.body) {
+    Readable.fromWeb(response.body as any).pipe(res);
+  } else {
+    res.end();
+  }
+}
