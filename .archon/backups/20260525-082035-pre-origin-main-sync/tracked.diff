+    "cache-control",
+    spaFallback || path.basename(filePath) === "index.html"
+      ? "no-cache"
+      : "public, max-age=31536000, immutable"
+  );
+
+  if (method.toUpperCase() === "HEAD") {
+    res.end();
+    return;
+  }
+
+  fs.createReadStream(filePath).pipe(res);
+}
