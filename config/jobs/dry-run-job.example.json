{
  "schema_version": "drakon.job.v1",
  "job_id": "job_dry_run_01",
  "name": "Dry-run perimeter review",
  "enabled": true,
  "camera_ids": ["cam_test_01"],
  "trigger": {
    "type": "manual",
    "source": "cli"
  },
  "schedule": {
    "mode": "none",
    "timezone": "America/Manaus"
  },
  "agent_id": "agent_dry_run_01",
  "inference_profile": {
    "enabled": false,
    "mode": "dry-run"
  },
  "alert_policy": {
    "mode": "disabled"
  },
  "output_policy": {
    "write_jsonl": true,
    "index": "jobs.jsonl"
  },
  "steps": [
    {
      "step_id": "step_read_recent_frames",
      "type": "frame_index_read",
      "name": "Read recent frame index",
      "enabled": true,
      "input": {
        "index": "frames.jsonl",
        "camera_ids": ["cam_test_01"],
        "limit": 5
      },
      "condition": {
        "type": "always"
      },
      "action": {
        "type": "read_frames",
        "params": {
          "mode": "dry-run"
        }
      },
      "next_on_success": "step_agent_stub",
      "next_on_failure": null,
      "timeout_seconds": 10,
      "retry_policy": {
        "max_attempts": 0,
        "backoff_seconds": 0
      }
    },
    {
      "step_id": "step_agent_stub",
      "type": "agent_evaluation",
      "name": "Simulate agent evaluation",
      "enabled": true,
      "agent_id": "agent_dry_run_01",
      "input": {
        "from_step": "step_read_recent_frames"
      },
      "condition": {
        "type": "previous_success"
      },
      "action": {
        "type": "agent",
        "params": {
          "dry_run_response": {
            "result": false,
            "reason": "No real inference is executed in Prompt 7."
          }
        }
      },
      "next_on_success": null,
      "next_on_failure": null,
      "timeout_seconds": 30,
      "retry_policy": {
        "max_attempts": 0,
        "backoff_seconds": 0
      }
    }
  ],
  "agents": [
    {
      "agent_id": "agent_dry_run_01",
      "name": "Dry-run agent",
      "type": "llm_stub",
      "model_provider": "dry-run",
      "model": "stub",
      "prompt_template_id": "prompt_dry_run_perimeter",
      "tools_allowed": ["read_frames_index"],
      "output_schema": {
        "type": "object",
        "required": ["result", "reason"],
        "properties": {
          "result": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "safety_policy": {
        "no_real_inference": true,
        "no_alert_delivery": true
      },
      "enabled": true
    }
  ],
  "created_at": "2026-05-21T00:00:00Z",
  "updated_at": "2026-05-21T00:00:00Z"
}
