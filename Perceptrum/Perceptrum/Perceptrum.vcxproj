      <KnowledgeContent Include="$(ProjectDir)orchestrator\knowledge\**\*.md" />
    </ItemGroup>
    <MakeDir Directories="$(TargetDir)orchestrator\knowledge" />
    <Copy
      SourceFiles="@(KnowledgeContent)"
      DestinationFiles="@(KnowledgeContent->'$(TargetDir)orchestrator\knowledge\%(RecursiveDir)%(Filename)%(Extension)')"
      SkipUnchangedFiles="true" />
  </Target>
