#!/usr/bin/env sh
set -eu

if [ -z "${APP_STATIC_ROOT:-}" ]; then
  APP_STATIC_ROOT="@PERCEPTRUM_LINUX_DEFAULT_WEB_ROOT@"
  export APP_STATIC_ROOT
fi

if [ -z "${PERCEPTRUM_BACKEND_COMMAND:-}" ]; then
  PERCEPTRUM_BACKEND_COMMAND="@PERCEPTRUM_LINUX_DEFAULT_BACKEND_COMMAND@"
  export PERCEPTRUM_BACKEND_COMMAND
fi

exec "@PERCEPTRUM_LINUX_DEFAULT_BINDIR@/perceptrum-desktop" "$@"
