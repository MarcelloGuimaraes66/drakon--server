  <Target Name="CopyOpenCvRuntime" AfterTargets="CopyMicrosoftWindowsAppRuntimeBootstrapdllToOutDir">
    <PropertyGroup>
      <_OpenCvRuntimeName Condition="'$(Configuration)' == 'Debug'">opencv_world4110d.dll</_OpenCvRuntimeName>
      <_OpenCvRuntimeName Condition="'$(_OpenCvRuntimeName)' == ''">opencv_world4110.dll</_OpenCvRuntimeName>
      <_OpenCvRuntimeSource>$(OpenCvBinRoot)$(_OpenCvRuntimeName)</_OpenCvRuntimeSource>
      <_OpenCvRuntimeDestination>$(OutDir)$(_OpenCvRuntimeName)</_OpenCvRuntimeDestination>
    </PropertyGroup>
    <Copy SourceFiles="$(_OpenCvRuntimeSource)"
          DestinationFiles="$(_OpenCvRuntimeDestination)"
          SkipUnchangedFiles="true"
          Condition="Exists('$(_OpenCvRuntimeSource)')" />
  </Target>

  <Target Name="CopyPerceptrumRuntimeDlls" AfterTargets="CopyMicrosoftWindowsAppRuntimeBootstrapdllToOutDir">
    <ItemGroup>
      <PerceptrumRuntimeDll Include="$(VcpkgRuntimeBinRoot)avcodec-61.dll" />
      <PerceptrumRuntimeDll Include="$(VcpkgRuntimeBinRoot)avformat-61.dll" />
      <PerceptrumRuntimeDll Include="$(VcpkgRuntimeBinRoot)avutil-59.dll" />
      <PerceptrumRuntimeDll Include="$(VcpkgRuntimeBinRoot)libcurl.dll" />
      <PerceptrumRuntimeDll Include="$(VcpkgRuntimeBinRoot)swresample-5.dll" />
      <PerceptrumRuntimeDll Include="$(VcpkgRuntimeBinRoot)swscale-8.dll" />
      <PerceptrumRuntimeDll Include="$(VcpkgRuntimeBinRoot)zlib1.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(PerceptrumRuntimeDll)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="Exists('%(PerceptrumRuntimeDll.Identity)')" />
  </Target>

  <Target Name="CopyPerceptrumRuntimeTools" AfterTargets="CopyPerceptrumRuntimeDlls">
    <ItemGroup>
      <PerceptrumRuntimeTool Include="$(PerceptrumLegacyReleaseRoot)ffmpeg.exe"
                             Condition="Exists('$(PerceptrumLegacyReleaseRoot)ffmpeg.exe')" />
      <PerceptrumRuntimeTool Include="$(PerceptrumLegacyReleaseServerRoot)ffmpeg.exe"
                             Condition="!Exists('$(PerceptrumLegacyReleaseRoot)ffmpeg.exe') and Exists('$(PerceptrumLegacyReleaseServerRoot)ffmpeg.exe')" />
    </ItemGroup>
    <Copy SourceFiles="@(PerceptrumRuntimeTool)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="'@(PerceptrumRuntimeTool)' != ''" />
  </Target>

  <Target Name="CopyMsvcRuntime" AfterTargets="CopyPerceptrumRuntimeTools" Condition="'$(UseDebugLibraries)'!='true'">
    <Exec Command='powershell -NoProfile -ExecutionPolicy Bypass -File "$(ProjectDir)..\Perceptrum\scripts\copy-msvc-runtime.ps1" -TargetDir "$(OutDir)." -PlatformName "$(Platform)" -VCToolsRedistDir "$(VCToolsRedistDir)"' />
  </Target>
