<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="DrakonPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource DrakonPanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DrakonPanelBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="Padding" Value="20" />
    </Style>

    <Style x:Key="DrakonHeroPanelStyle" TargetType="Border" BasedOn="{StaticResource DrakonPanelStyle}">
        <Setter Property="Background" Value="{StaticResource DrakonHeroBrush}" />
        <Setter Property="Padding" Value="24" />
    </Style>

    <Style x:Key="DrakonInsetPanelStyle" TargetType="Border" BasedOn="{StaticResource DrakonPanelStyle}">
        <Setter Property="Background" Value="{StaticResource DrakonPanelAltBrush}" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="16" />
    </Style>

</ResourceDictionary>
