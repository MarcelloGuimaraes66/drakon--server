<?xml version="1.0" encoding="utf-8"?>
<Page
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{StaticResource DrakonShellBackgroundBrush}">

    <Grid Background="{StaticResource DrakonShellBackgroundBrush}">
        <WebView2 x:Name="SiteWebView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

        <Border
            x:Name="BackButtonHost"
            Margin="18,18,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Background="{StaticResource DrakonShellChipBrush}"
            BorderBrush="{StaticResource DrakonShellChipBorderBrush}"
            BorderThickness="1"
            CornerRadius="999"
            Visibility="Collapsed">
            <Button
                x:Name="BackButton"
                Padding="16,10"
                Background="Transparent"
                Foreground="{StaticResource DrakonStrongTextBrush}"
                Content="Voltar" />
        </Border>

        <Grid
            x:Name="LoadingOverlay"
            Background="{StaticResource DrakonOverlayBrush}"
            Visibility="Collapsed">
            <Border
                MaxWidth="760"
                Padding="34"
                Background="{StaticResource DrakonPanelBrush}"
                BorderBrush="{StaticResource DrakonPanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <Grid ColumnSpacing="28">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid
                        Width="104"
                        Height="104"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top">
                        <Border
                            Width="104"
                            Height="104"
                            Background="{StaticResource DrakonHeroBrush}"
                            CornerRadius="30"
                            Opacity="0.9" />
                        <Border
                            Width="76"
                            Height="76"
                            Background="{StaticResource DrakonShellBackgroundBrush}"
                            BorderBrush="{StaticResource DrakonShellChipBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="24"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <Image
                                Width="42"
                                Height="42"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Source="ms-appx:///Assets/Branding/icon-dark.png"
                                Stretch="Uniform" />
                        </Border>
                        <ProgressRing
                            x:Name="LoadingProgressRing"
                            Width="104"
                            Height="104"
                            Foreground="{StaticResource DrakonAccentBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsActive="True" />
                    </Grid>

                    <StackPanel
                        Grid.Column="1"
                        Spacing="18"
                        VerticalAlignment="Center">
                        <Image
                            Height="34"
                            HorizontalAlignment="Left"
                            Source="ms-appx:///Assets/Branding/wordmark-dark.png"
                            Stretch="Uniform" />

                        <StackPanel Spacing="8">
                            <TextBlock
                                x:Name="StatusTitleText"
                                FontSize="30"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource DrakonStrongTextBrush}"
                                Text="Preparando o aplicativo" />
                            <TextBlock
                                x:Name="StatusDetailText"
                                TextWrapping="WrapWholeWords"
                                Style="{StaticResource DrakonBodyTextStyle}"
                                Text="Estamos abrindo a interface local com a identidade do produto." />
                        </StackPanel>

                        <StackPanel
                            x:Name="OverlayActionsHost"
                            Orientation="Horizontal"
                            Spacing="12"
                            Visibility="Collapsed">
                            <Button
                                x:Name="ReloadButton"
                                Padding="16,10"
                                Background="{StaticResource DrakonAccentBrush}"
                                Foreground="White"
                                Content="Recarregar" />
                            <Button
                                x:Name="OpenInBrowserButton"
                                Padding="16,10"
                                Background="{StaticResource DrakonShellChipBrush}"
                                BorderBrush="{StaticResource DrakonShellChipBorderBrush}"
                                BorderThickness="1"
                                Foreground="{StaticResource DrakonStrongTextBrush}"
                                Content="Abrir no navegador" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
