<?xml version="1.0" encoding="utf-8"?>
<Page
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent"
    RequestedTheme="Dark">
    <Page.Resources>
        <Style x:Key="DashboardPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="#FF1A1A1A" />
            <Setter Property="BorderBrush" Value="#FF2E2E2E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="16" />
        </Style>
        <Style x:Key="DashboardInsetPanelStyle" TargetType="Border">
            <Setter Property="Background" Value="#FF151515" />
            <Setter Property="BorderBrush" Value="#FF2A2A2A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style x:Key="FilterChipStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF1F4E8C" />
            <Setter Property="BorderBrush" Value="#FF335D94" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Foreground" Value="#FFD9E7FF" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Page.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="8,4,8,0">
            <StackPanel MaxWidth="1650" HorizontalAlignment="Stretch" Spacing="20">
                <InfoBar x:Name="DashboardInfoBar" IsOpen="False" IsClosable="True" Severity="Informational" />
                <StackPanel x:Name="DesktopLayout" Spacing="20">
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" BorderBrush="#FF23456A" BorderThickness="1" CornerRadius="16" Padding="20" Background="#FF172537"><StackPanel Spacing="10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Foreground="#FFA4A4A4" FontSize="14" FontWeight="SemiBold" Text="Cameras Running" /><FontIcon Grid.Column="1" FontFamily="Segoe Fluent Icons" FontSize="18" Glyph="&#xE722;" Foreground="#FFA4A4A4" /></Grid><TextBlock x:Name="DesktopCamerasRunningValueText" FontSize="32" FontWeight="Bold" Foreground="White" Text="0/28" /></StackPanel></Border>
                        <Border Grid.Column="1" BorderBrush="#FF205236" BorderThickness="1" CornerRadius="16" Padding="20" Background="#FF14311F"><StackPanel Spacing="10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Foreground="#FFA4A4A4" FontSize="14" FontWeight="SemiBold" Text="Jobs Running" /><FontIcon Grid.Column="1" FontFamily="Segoe Fluent Icons" FontSize="18" Glyph="&#xE823;" Foreground="#FFA4A4A4" /></Grid><TextBlock x:Name="DesktopJobsRunningValueText" FontSize="32" FontWeight="Bold" Foreground="White" Text="0/2" /></StackPanel></Border>
                        <Border Grid.Column="2" BorderBrush="#FF1D5A54" BorderThickness="1" CornerRadius="16" Padding="20" Background="#FF103432"><StackPanel Spacing="10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Foreground="#FFA4A4A4" FontSize="14" FontWeight="SemiBold" Text="Steps Running" /><FontIcon Grid.Column="1" FontFamily="Segoe Fluent Icons" FontSize="18" Glyph="&#xE8FD;" Foreground="#FFA4A4A4" /></Grid><TextBlock x:Name="DesktopStepsRunningValueText" FontSize="32" FontWeight="Bold" Foreground="White" Text="0" /></StackPanel></Border>
                        <Border Grid.Column="3" BorderBrush="#FF32384C" BorderThickness="1" CornerRadius="16" Padding="20" Background="#FF1D202A"><StackPanel Spacing="10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Foreground="#FFA4A4A4" FontSize="14" FontWeight="SemiBold" Text="Enabled Agents" /><FontIcon Grid.Column="1" FontFamily="Segoe Fluent Icons" FontSize="18" Glyph="&#xE945;" Foreground="#FFA4A4A4" /></Grid><TextBlock x:Name="DesktopAgentsEnabledValueText" FontSize="32" FontWeight="Bold" Foreground="White" Text="0" /></StackPanel></Border>
                        <Border Grid.Column="4" BorderBrush="#FF6C3A17" BorderThickness="1" CornerRadius="16" Padding="20" Background="#FF442914"><StackPanel Spacing="10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Foreground="#FFA4A4A4" FontSize="14" FontWeight="SemiBold" Text="Detections" /><FontIcon Grid.Column="1" FontFamily="Segoe Fluent Icons" FontSize="18" Glyph="&#xE9D2;" Foreground="#FFA4A4A4" /></Grid><TextBlock x:Name="DesktopDetections24hValueText" FontSize="32" FontWeight="Bold" Foreground="White" Text="0" /><TextBlock FontSize="12" Foreground="#FF9D9D9D" Text="Last 24h" /></StackPanel></Border>
                        <Border Grid.Column="5" BorderBrush="#FF746017" BorderThickness="1" CornerRadius="16" Padding="20" Background="#FF4A3B12"><StackPanel Spacing="10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Foreground="#FFA4A4A4" FontSize="14" FontWeight="SemiBold" Text="Pending Commands" /><FontIcon Grid.Column="1" FontFamily="Segoe Fluent Icons" FontSize="18" Glyph="&#xE765;" Foreground="#FFA4A4A4" /></Grid><TextBlock x:Name="DesktopPendingCommandsValueText" FontSize="32" FontWeight="Bold" Foreground="White" Text="0" /></StackPanel></Border>
                        <Border Grid.Column="6" BorderBrush="#FF6E2323" BorderThickness="1" CornerRadius="16" Padding="20" Background="#FF452020"><StackPanel Spacing="10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Foreground="#FFA4A4A4" FontSize="14" FontWeight="SemiBold" Text="Unread Alerts" /><FontIcon Grid.Column="1" FontFamily="Segoe Fluent Icons" FontSize="18" Glyph="&#xE7ED;" Foreground="#FFA4A4A4" /></Grid><TextBlock x:Name="DesktopUnreadAlertsValueText" FontSize="32" FontWeight="Bold" Foreground="White" Text="0" /></StackPanel></Border>
                    </Grid>

                    <Grid ColumnSpacing="6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="360" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource DashboardPanelStyle}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Grid Padding="16,16,16,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock FontSize="22" FontWeight="Bold" Foreground="White" Text="Jobs &amp; Pipelines" /><TextBlock Grid.Column="1" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource DrakonAccentBrush}" Text="Manage →" VerticalAlignment="Center" /></Grid>
                                <StackPanel Grid.Row="1" Padding="16,0,16,16" Spacing="18">
                                    <StackPanel Spacing="10"><TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#FFB9B9B9" Text="Running Jobs" /><TextBlock HorizontalAlignment="Center" Margin="0,24,0,24" FontSize="14" Foreground="#FF707070" Text="No jobs running" /></StackPanel>
                                    <StackPanel Spacing="10"><TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#FFB9B9B9" Text="Upcoming Schedules" /><Border Style="{StaticResource DashboardInsetPanelStyle}"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Spacing="4"><TextBlock FontSize="15" FontWeight="SemiBold" Foreground="White" Text="Visita Patio" /><TextBlock FontSize="13" Foreground="#FF8F8F8F" Text="1 cameras - 1 steps" /></StackPanel><Border Grid.Column="1" Background="#FF252525" CornerRadius="10" Padding="10,7"><TextBlock FontSize="13" Foreground="#FFD3D3D3" Text="11:29" /></Border></Grid></Border></StackPanel>
                                    <StackPanel Spacing="10"><TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#FFB9B9B9" Text="Recent Job Starts" /><Border Style="{StaticResource DashboardInsetPanelStyle}"><StackPanel Spacing="4"><TextBlock FontSize="15" FontWeight="SemiBold" Foreground="White" Text="Find Armed Person" /><TextBlock FontSize="13" Foreground="#FF8F8F8F" Text="1 steps • sent • 1h" /></StackPanel></Border><Border Style="{StaticResource DashboardInsetPanelStyle}"><StackPanel Spacing="4"><TextBlock FontSize="15" FontWeight="SemiBold" Foreground="White" Text="Find Armed Person" /><TextBlock FontSize="13" Foreground="#FF8F8F8F" Text="1 steps • sent • 2h" /></StackPanel></Border><Border Style="{StaticResource DashboardInsetPanelStyle}"><StackPanel Spacing="4"><TextBlock FontSize="15" FontWeight="SemiBold" Foreground="White" Text="Look for an armed person" /><TextBlock FontSize="13" Foreground="#FF8F8F8F" Text="1 steps • sent • 2h" /></StackPanel></Border></StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource DashboardPanelStyle}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Grid Padding="18,16,18,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock FontSize="22" FontWeight="Bold" Foreground="White" Text="Recent Alerts" /><Border Grid.Column="1" Background="#FF1D1D1D" BorderBrush="#FF444444" BorderThickness="1" CornerRadius="18" Padding="12,8"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon FontFamily="Segoe Fluent Icons" FontSize="15" Glyph="&#xECA5;" Foreground="#FFD6D6D6" /><TextBlock FontSize="14" FontWeight="SemiBold" Foreground="#FFD6D6D6" Text="4" /></StackPanel></Border></Grid>
                                <Grid Grid.Row="1" Padding="18,0,18,14" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Border Background="#FF181818" BorderBrush="#FF333333" BorderThickness="1" CornerRadius="14" Padding="12,10"><Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><FontIcon FontFamily="Segoe Fluent Icons" FontSize="16" Glyph="&#xE721;" Foreground="#FF676767" /><TextBlock Grid.Column="1" FontSize="14" Foreground="#FF747474" Text="Search alerts..." /></Grid></Border>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Style="{StaticResource FilterChipStyle}" Background="#FF2B2B2B" BorderBrush="#FF3A3A3A" Foreground="#FFD2D2D2" Content="All" /><Button Style="{StaticResource FilterChipStyle}" Content="Critic" /><Button Style="{StaticResource FilterChipStyle}" Content="High" /><Button Style="{StaticResource FilterChipStyle}" Content="Medium" /><Button Style="{StaticResource FilterChipStyle}" Content="Low" /></StackPanel>
                                </Grid>
                                <Grid Grid.Row="2" Padding="18,0,18,18" ColumnSpacing="16" RowSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource DashboardInsetPanelStyle}" Padding="0"><StackPanel><Border Height="230" Margin="10" Background="#FF3A3A3A" CornerRadius="12"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="#FF868686" Text="Video preview" /></Border><StackPanel Padding="12,0,12,12" Spacing="6"><TextBlock x:Name="DesktopAlertOneTitleText" FontSize="15" FontWeight="SemiBold" Foreground="White" Text="camera 12" /><TextBlock x:Name="DesktopAlertOneSubtitleText" FontSize="13" Foreground="#FF8E8E8E" Text="Job: Find Armed Person • Step: 1" TextWrapping="WrapWholeWords" /></StackPanel></StackPanel></Border>
                                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource DashboardInsetPanelStyle}" Padding="0"><StackPanel><Border Height="230" Margin="10" Background="#FF3A3A3A" CornerRadius="12"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="#FF868686" Text="Video preview" /></Border><StackPanel Padding="12,0,12,12" Spacing="6"><TextBlock x:Name="DesktopAlertTwoTitleText" FontSize="15" FontWeight="SemiBold" Foreground="White" Text="camera 11" /><TextBlock x:Name="DesktopAlertTwoSubtitleText" FontSize="13" Foreground="#FF8E8E8E" Text="Job: Find Armed Person • Step: 1" TextWrapping="WrapWholeWords" /></StackPanel></StackPanel></Border>
                                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource DashboardInsetPanelStyle}" Padding="0"><StackPanel><Border Height="230" Margin="10" Background="#FF385041" CornerRadius="12"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="#FFC9E5D8" Text="Snapshot preview" /></Border><StackPanel Padding="12,0,12,12" Spacing="6"><TextBlock x:Name="DesktopAlertThreeTitleText" FontSize="15" FontWeight="SemiBold" Foreground="White" Text="camera garden-01" /><TextBlock x:Name="DesktopAlertThreeSubtitleText" FontSize="13" Foreground="#FF8E8E8E" Text="Investigative snapshot ready for review" TextWrapping="WrapWholeWords" /></StackPanel></StackPanel></Border>
                                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource DashboardInsetPanelStyle}" Padding="0"><StackPanel><Border Height="230" Margin="10" Background="#FF4A4A2C" CornerRadius="12"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="#FFF1E9B8" Text="Snapshot preview" /></Border><StackPanel Padding="12,0,12,12" Spacing="6"><TextBlock x:Name="DesktopAlertFourTitleText" FontSize="15" FontWeight="SemiBold" Foreground="White" Text="camera corridor-02" /><TextBlock x:Name="DesktopAlertFourSubtitleText" FontSize="13" Foreground="#FF8E8E8E" Text="Investigative snapshot ready for review" TextWrapping="WrapWholeWords" /></StackPanel></StackPanel></Border>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </StackPanel>
                <StackPanel x:Name="CompactLayout" Visibility="Collapsed" Spacing="16">
                    <Grid ColumnSpacing="12" RowSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Border Grid.Row="0" Grid.Column="0" Style="{StaticResource DashboardInsetPanelStyle}"><StackPanel Spacing="6"><TextBlock FontSize="13" Foreground="#FFA4A4A4" Text="Cameras Running" /><TextBlock x:Name="CompactCamerasRunningValueText" FontSize="28" FontWeight="Bold" Foreground="White" Text="0/28" /></StackPanel></Border><Border Grid.Row="0" Grid.Column="1" Style="{StaticResource DashboardInsetPanelStyle}"><StackPanel Spacing="6"><TextBlock FontSize="13" Foreground="#FFA4A4A4" Text="Jobs Running" /><TextBlock x:Name="CompactJobsRunningValueText" FontSize="28" FontWeight="Bold" Foreground="White" Text="0/2" /></StackPanel></Border><Border Grid.Row="1" Grid.Column="0" Style="{StaticResource DashboardInsetPanelStyle}"><StackPanel Spacing="6"><TextBlock FontSize="13" Foreground="#FFA4A4A4" Text="Enabled Agents" /><TextBlock x:Name="CompactAgentsEnabledValueText" FontSize="28" FontWeight="Bold" Foreground="White" Text="0" /></StackPanel></Border><Border Grid.Row="1" Grid.Column="1" Style="{StaticResource DashboardInsetPanelStyle}"><StackPanel Spacing="6"><TextBlock FontSize="13" Foreground="#FFA4A4A4" Text="Unread Alerts" /><TextBlock x:Name="CompactUnreadAlertsValueText" FontSize="28" FontWeight="Bold" Foreground="White" Text="0" /></StackPanel></Border><Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource DashboardPanelStyle}"><StackPanel Spacing="10"><TextBlock FontSize="20" FontWeight="Bold" Foreground="White" Text="Jobs &amp; Pipelines" /><TextBlock FontSize="13" Foreground="#FF8F8F8F" Text="Visita Patio • 11:29 • 1 cameras - 1 steps" TextWrapping="WrapWholeWords" /><TextBlock FontSize="13" Foreground="#FF8F8F8F" Text="Recent starts: Find Armed Person, Look for an armed person" TextWrapping="WrapWholeWords" /></StackPanel></Border><Border Grid.Row="3" Grid.ColumnSpan="2" Style="{StaticResource DashboardPanelStyle}"><StackPanel Spacing="12"><Border Height="180" Background="#FF3A3A3A" CornerRadius="14"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16" Foreground="#FF868686" Text="Alert preview" /></Border><TextBlock x:Name="CompactAlertOneTitleText" FontSize="15" FontWeight="SemiBold" Foreground="White" Text="camera 12" /><TextBlock x:Name="CompactAlertOneSubtitleText" FontSize="13" Foreground="#FF8E8E8E" Text="Job: Find Armed Person • Step: 1" TextWrapping="WrapWholeWords" /><TextBlock x:Name="CompactAlertTwoTitleText" FontSize="15" FontWeight="SemiBold" Foreground="White" Text="camera 11" /><TextBlock x:Name="CompactAlertTwoSubtitleText" FontSize="13" Foreground="#FF8E8E8E" Text="Job: Find Armed Person • Step: 1" TextWrapping="WrapWholeWords" /></StackPanel></Border></Grid>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
