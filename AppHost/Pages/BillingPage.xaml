<?xml version="1.0" encoding="utf-8"?>
<Page
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent"
    RequestedTheme="Dark">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="24">
            <StackPanel
                MaxWidth="1600"
                HorizontalAlignment="Center"
                Spacing="20">
                <StackPanel Spacing="6">
                    <TextBlock
                        Style="{StaticResource DrakonDisplayTitleTextStyle}"
                        Text="Billing" />
                    <TextBlock
                        Style="{StaticResource DrakonBodyTextStyle}"
                        Text="Assinaturas, tokens, histórico de pagamentos e cartões salvos convertidos do DrakonSite para o shell WinUI 3."
                        TextWrapping="WrapWholeWords" />
                </StackPanel>

                <InfoBar
                    x:Name="BillingInfoBar"
                    IsOpen="False"
                    IsClosable="True"
                    Severity="Informational" />

                <Grid
                    x:Name="SubscriptionGrid"
                    ColumnSpacing="16"
                    RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        x:Name="SubscriptionCard"
                        Grid.Row="0"
                        Grid.Column="0"
                        Style="{StaticResource DrakonPanelStyle}">
                        <StackPanel Spacing="18">
                            <StackPanel Spacing="4">
                                <TextBlock
                                    Style="{StaticResource DrakonCaptionTextStyle}"
                                    Foreground="{StaticResource DrakonAccentBrush}"
                                    Text="AI Agent Subscription" />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock
                                        x:Name="SubscriptionPriceText"
                                        FontSize="36"
                                        FontWeight="SemiBold"
                                        Text="$17.20" />
                                    <TextBlock
                                        Margin="0,12,0,0"
                                        Style="{StaticResource DrakonCaptionTextStyle}"
                                        Text="per month" />
                                </StackPanel>
                                <TextBlock
                                    x:Name="SubscriptionSummaryText"
                                    Style="{StaticResource DrakonBodyTextStyle}"
                                    Text="Plus plan • 1 camera • 1 frame every 3 seconds per camera"
                                    TextWrapping="WrapWholeWords" />
                                <TextBlock
                                    x:Name="SubscriptionPerCameraText"
                                    Style="{StaticResource DrakonCaptionTextStyle}"
                                    Text="$17.20 per camera / month" />
                            </StackPanel>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Spacing="4">
                                    <TextBlock
                                        Style="{StaticResource DrakonCaptionTextStyle}"
                                        Text="Cameras" />
                                    <TextBlock
                                        Style="{StaticResource DrakonBodyTextStyle}"
                                        Text="Escolha entre 1 e 32 câmeras, igual ao configurador do DrakonSite."
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>

                                <Border
                                    Grid.Column="1"
                                    Padding="10,8"
                                    Background="{StaticResource DrakonPanelAltBrush}"
                                    BorderBrush="{StaticResource DrakonPanelBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="999">
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="10"
                                        VerticalAlignment="Center">
                                        <Button
                                            x:Name="CameraCountMinusButton"
                                            MinWidth="36"
                                            Content="-" />
                                        <TextBlock
                                            x:Name="CameraCountValueText"
                                            MinWidth="84"
                                            HorizontalTextAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            Text="1x camera" />
                                        <Button
                                            x:Name="CameraCountPlusButton"
                                            MinWidth="36"
                                            Content="+" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid ColumnSpacing="16" RowSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel
                                    x:Name="TierSelectionPanel"
                                    Grid.Column="0"
                                    Spacing="10">
                                    <TextBlock
                                        Style="{StaticResource DrakonCaptionTextStyle}"
                                        Text="Model" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Button
                                            x:Name="TierLightButton"
                                            Grid.Column="0"
                                            Content="Light"
                                            Tag="light" />
                                        <Button
                                            x:Name="TierPlusButton"
                                            Grid.Column="1"
                                            Content="Plus"
                                            Tag="plus" />
                                        <Button
                                            x:Name="TierProButton"
                                            Grid.Column="2"
                                            Content="Pro"
                                            Tag="pro" />
                                    </Grid>
                                </StackPanel>

                                <StackPanel
                                    x:Name="SpeedSelectionPanel"
                                    Grid.Column="1"
                                    Spacing="10">
                                    <TextBlock
                                        Style="{StaticResource DrakonCaptionTextStyle}"
                                        Text="Analysis speed" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Button
                                            x:Name="Speed1Button"
                                            Grid.Column="0"
                                            Content="1/1"
                                            Tag="1" />
                                        <Button
                                            x:Name="Speed3Button"
                                            Grid.Column="1"
                                            Content="3/1"
                                            Tag="3" />
                                        <Button
                                            x:Name="Speed5Button"
                                            Grid.Column="2"
                                            Content="5/1"
                                            Tag="5" />
                                        <Button
                                            x:Name="Speed10Button"
                                            Grid.Column="3"
                                            Content="10/1"
                                            Tag="10" />
                                    </Grid>
                                    <TextBlock
                                        Style="{StaticResource DrakonCaptionTextStyle}"
                                        Text="1/1 para eventos rápidos; 10/1 para cenas mais lentas."
                                        TextWrapping="WrapWholeWords" />
                                </StackPanel>
                            </Grid>

                            <StackPanel
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="10">
                                <Button
                                    x:Name="BillingRefreshButton"
                                    Content="Refresh"
                                    MinWidth="112" />
                                <Button
                                    x:Name="SubscribeButton"
                                    MinWidth="160"
                                    Content="Subscribe" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border
                        x:Name="SubscriptionExplainCard"
                        Grid.Row="0"
                        Grid.Column="1"
                        Style="{StaticResource DrakonInsetPanelStyle}">
                        <StackPanel Spacing="12">
                            <TextBlock
                                Style="{StaticResource DrakonSectionTitleTextStyle}"
                                Text="How it works" />
                            <TextBlock
                                Style="{StaticResource DrakonCaptionTextStyle}"
                                Text="Light é otimizado para menor custo. Plus equilibra custo e raciocínio. Pro é a opção mais avançada para cenários mais complexos."
                                TextWrapping="WrapWholeWords" />
                            <TextBlock
                                Style="{StaticResource DrakonCaptionTextStyle}"
                                Text="A velocidade de análise controla quantos frames por câmera entram no pipeline nativo do executável."
                                TextWrapping="WrapWholeWords" />
                            <TextBlock
                                Style="{StaticResource DrakonMonoTextStyle}"
                                Text="light|plus|pro x 1|3|5|10 sec x 1..32 cameras"
                                TextWrapping="WrapWholeWords" />
                        </StackPanel>
                    </Border>
                </Grid>

                <StackPanel Spacing="12">
                    <TextBlock
                        Style="{StaticResource DrakonSectionTitleTextStyle}"
                        Text="Drakon Chat Tokens" />

                    <Grid
                        x:Name="TokenCardsGrid"
                        ColumnSpacing="16"
                        RowSpacing="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            x:Name="TokenBalanceCard"
                            Grid.Row="0"
                            Grid.Column="0"
                            Style="{StaticResource DrakonHeroPanelStyle}">
                            <StackPanel Spacing="12">
                                <TextBlock
                                    Style="{StaticResource DrakonCaptionTextStyle}"
                                    Foreground="{StaticResource DrakonStrongTextBrush}"
                                    Text="Token Balance" />
                                <Grid ColumnSpacing="18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock Style="{StaticResource DrakonCaptionTextStyle}" Foreground="{StaticResource DrakonStrongTextBrush}" Text="Input" />
                                        <TextBlock
                                            x:Name="TokenInputValueText"
                                            FontSize="26"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource DrakonStrongTextBrush}"
                                            Text="0" />
                                    </StackPanel>
                                    <Border
                                        Grid.Column="1"
                                        Width="1"
                                        Background="{StaticResource DrakonStrongTextBrush}"
                                        Opacity="0.2" />
                                    <StackPanel
                                        Grid.Column="2"
                                        Spacing="4">
                                        <TextBlock Style="{StaticResource DrakonCaptionTextStyle}" Foreground="{StaticResource DrakonStrongTextBrush}" Text="Output" />
                                        <TextBlock
                                            x:Name="TokenOutputValueText"
                                            FontSize="26"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource DrakonStrongTextBrush}"
                                            Text="0" />
                                    </StackPanel>
                                </Grid>
                                <Button
                                    x:Name="BuyTokensButton"
                                    Content="Buy Tokens" />
                            </StackPanel>
                        </Border>

                        <Border
                            x:Name="TotalSpentCard"
                            Grid.Row="0"
                            Grid.Column="1"
                            Style="{StaticResource DrakonInsetPanelStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource DrakonCaptionTextStyle}" Text="Total spent" />
                                <TextBlock
                                    x:Name="TotalSpentValueText"
                                    FontSize="28"
                                    FontWeight="SemiBold"
                                    Text="0" />
                                <TextBlock
                                    Style="{StaticResource DrakonCaptionTextStyle}"
                                    Text="Tokens used across the lifetime of the account."
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Border>

                        <Border
                            x:Name="ActiveCamerasCard"
                            Grid.Row="0"
                            Grid.Column="2"
                            Style="{StaticResource DrakonInsetPanelStyle}">
                            <StackPanel Spacing="8">
                                <TextBlock Style="{StaticResource DrakonCaptionTextStyle}" Text="Active cameras" />
                                <TextBlock
                                    x:Name="ActiveCamerasValueText"
                                    FontSize="28"
                                    FontWeight="SemiBold"
                                    Text="0" />
                                <TextBlock
                                    Style="{StaticResource DrakonCaptionTextStyle}"
                                    Text="Subscribed or currently active cameras tied to the billing state."
                                    TextWrapping="WrapWholeWords" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <StackPanel Spacing="12">
                    <TextBlock
                        Style="{StaticResource DrakonSectionTitleTextStyle}"
                        Text="Payment History" />

                    <Border Style="{StaticResource DrakonPanelStyle}">
                        <StackPanel Spacing="12">
                            <Border
                                x:Name="PaymentsEmptyStateBorder"
                                Style="{StaticResource DrakonInsetPanelStyle}">
                                <TextBlock
                                    Style="{StaticResource DrakonBodyTextStyle}"
                                    Text="No payment history available yet." />
                            </Border>

                            <StackPanel
                                x:Name="PaymentsHost"
                                Spacing="12" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Spacing="12">
                    <Button
                        x:Name="ManagePlansCardsButton"
                        HorizontalAlignment="Center"
                        MinWidth="220"
                        Content="Manage Plans &amp; Cards" />

                    <Border
                        x:Name="ManageSectionBorder"
                        Visibility="Collapsed"
                        Style="{StaticResource DrakonPanelStyle}">
                        <StackPanel Spacing="16">
                            <TextBlock
                                Style="{StaticResource DrakonSectionTitleTextStyle}"
                                Text="Manage Plans &amp; Cards" />

                            <Grid
                                x:Name="ManageGrid"
                                ColumnSpacing="16"
                                RowSpacing="16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    x:Name="ManageSubscriptionCard"
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Style="{StaticResource DrakonInsetPanelStyle}">
                                    <StackPanel Spacing="10">
                                        <TextBlock
                                            Style="{StaticResource DrakonCaptionTextStyle}"
                                            Text="Current subscription" />
                                        <TextBlock
                                            x:Name="ManageSubscriptionTitleText"
                                            FontSize="20"
                                            FontWeight="SemiBold"
                                            Text="No active subscription" />
                                        <TextBlock
                                            x:Name="ManageSubscriptionStatusText"
                                            Style="{StaticResource DrakonBodyTextStyle}"
                                            Text="The backend returned no active subscription." />
                                        <TextBlock
                                            x:Name="ManageSubscriptionAccessText"
                                            Style="{StaticResource DrakonCaptionTextStyle}"
                                            Text="" />
                                        <Button
                                            x:Name="CancelSubscriptionButton"
                                            HorizontalAlignment="Left"
                                            Content="Cancel Subscription"
                                            IsEnabled="False" />
                                    </StackPanel>
                                </Border>

                                <Border
                                    x:Name="ManageCardsCard"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    Style="{StaticResource DrakonInsetPanelStyle}">
                                    <StackPanel Spacing="10">
                                        <TextBlock
                                            Style="{StaticResource DrakonCaptionTextStyle}"
                                            Text="Saved cards" />
                                        <TextBlock
                                            x:Name="CardsSummaryText"
                                            Style="{StaticResource DrakonBodyTextStyle}"
                                            Text="No saved cards." />
                                        <StackPanel
                                            x:Name="CardsHost"
                                            Spacing="10" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
