<?xml version="1.0" encoding="utf-8"?>
<Page
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Transparent"
    RequestedTheme="Dark">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="6">
            <TextBlock
                Style="{StaticResource DrakonDisplayTitleTextStyle}"
                Text="Chat" />
            <TextBlock
                Style="{StaticResource DrakonBodyTextStyle}"
                Text="Port nativo do workspace de chat do DrakonSite com sessões, mensagens, token gate, pairing awareness e envio de prompts para o backend autenticado."
                TextWrapping="WrapWholeWords" />
        </StackPanel>

        <InfoBar
            x:Name="ChatInfoBar"
            Grid.Row="2"
            IsOpen="False"
            IsClosable="True"
            Severity="Informational" />

        <Grid
            x:Name="ResponsiveContentGrid"
            Grid.Row="4"
            ColumnSpacing="16"
            RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SessionsColumnDefinition" Width="340" />
                <ColumnDefinition x:Name="ConversationColumnDefinition" Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                x:Name="SessionsBorder"
                Grid.RowSpan="2"
                Style="{StaticResource DrakonPanelStyle}">
                <Grid RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="12">
                        <TextBlock
                            Style="{StaticResource DrakonSectionTitleTextStyle}"
                            Text="Sessions" />

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Button
                                x:Name="NewSessionButton"
                                Content="New chat"
                                Style="{StaticResource AccentButtonStyle}" />
                            <Button
                                x:Name="RefreshChatButton"
                                Grid.Column="1"
                                Content="Refresh" />
                        </Grid>

                        <TextBlock
                            x:Name="ChatPairingSummaryText"
                            Style="{StaticResource DrakonCaptionTextStyle}"
                            Text="Pairing status: checking..." />

                        <TextBlock
                            x:Name="ChatTokenBalanceSummaryText"
                            Style="{StaticResource DrakonCaptionTextStyle}"
                            Text="Tokens: checking..." />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel
                            x:Name="SessionItemsHost"
                            Spacing="12" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border
                x:Name="ConversationBorder"
                Grid.Column="1"
                Grid.RowSpan="2"
                Style="{StaticResource DrakonPanelStyle}">
                <Grid RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Spacing="14">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="4">
                                <TextBlock
                                    x:Name="ActiveSessionTitleText"
                                    Style="{StaticResource DrakonSectionTitleTextStyle}"
                                    Text="Select a chat session" />
                                <TextBlock
                                    x:Name="ActiveSessionSubtitleText"
                                    Style="{StaticResource DrakonCaptionTextStyle}"
                                    Text="The conversation panel mirrors the same backend contract used by the web UI." />
                            </StackPanel>

                            <Button
                                x:Name="RenameSessionButton"
                                Grid.Column="1"
                                Content="Rename" />
                            <Button
                                x:Name="DeleteSessionButton"
                                Grid.Column="2"
                                Content="Delete" />
                        </Grid>

                        <Grid ColumnSpacing="10" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ComboBox
                                x:Name="ModelTierComboBox"
                                PlaceholderText="Model tier" />
                            <ComboBox
                                x:Name="ModelFpsComboBox"
                                Grid.Column="1"
                                PlaceholderText="FPS" />
                            <ComboBox
                                x:Name="RunningResolutionComboBox"
                                Grid.Column="2"
                                PlaceholderText="Resolution" />
                            <ComboBox
                                x:Name="CameraSelectionComboBox"
                                Grid.Column="3"
                                PlaceholderText="Camera" />

                            <TextBlock
                                x:Name="PendingExecutionText"
                                Grid.Row="1"
                                Grid.ColumnSpan="4"
                                Style="{StaticResource DrakonCaptionTextStyle}"
                                Text="Desktop runtime status will appear here when the backend reports pending execution." />
                        </Grid>
                    </StackPanel>

                    <Border
                        Grid.Row="1"
                        Background="{StaticResource DrakonPanelAltBrush}"
                        BorderBrush="{StaticResource DrakonPanelBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="0">
                        <ScrollViewer
                            x:Name="MessagesScrollViewer"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel
                                x:Name="MessageItemsHost"
                                Padding="18"
                                Spacing="14" />
                        </ScrollViewer>
                    </Border>

                    <StackPanel
                        Grid.Row="2"
                        Spacing="12">
                        <TextBox
                            x:Name="MessageInputTextBox"
                            AcceptsReturn="True"
                            MinHeight="120"
                            PlaceholderText="Send the same operational prompt you would send from the web chat..."
                            TextWrapping="Wrap" />

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Style="{StaticResource DrakonCaptionTextStyle}"
                                Text="Attachments and hit-media upload are still pending in the next conversion slice."
                                TextWrapping="WrapWholeWords"
                                VerticalAlignment="Center" />

                            <Button
                                x:Name="CancelPendingButton"
                                Grid.Column="1"
                                Content="Cancel pending" />
                            <Button
                                x:Name="SendMessageButton"
                                Grid.Column="2"
                                Content="Send"
                                Style="{StaticResource AccentButtonStyle}" />
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
