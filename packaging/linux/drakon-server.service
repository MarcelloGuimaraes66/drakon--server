[Unit]
Description=Drakon Server headless camera processing service
Documentation=file:/usr/share/doc/drakon-server/INSTALL.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=DRAKON_CONFIG=/etc/drakon-server/drakon-server.json
EnvironmentFile=-/etc/drakon-server/drakon-server.env
ExecStartPre=/opt/drakon-server/bin/drakon-server validate-config --config ${DRAKON_CONFIG}
ExecStartPre=/opt/drakon-server/bin/drakon-server prepare-runtime --config ${DRAKON_CONFIG}
ExecStart=/opt/drakon-server/bin/drakon-server run --config ${DRAKON_CONFIG}
WorkingDirectory=/var/lib/drakon-server
Restart=on-failure
RestartSec=5s
DynamicUser=yes
StateDirectory=drakon-server
LogsDirectory=drakon-server
RuntimeDirectory=drakon-server
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/drakon-server /var/log/drakon-server /run/drakon-server
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
