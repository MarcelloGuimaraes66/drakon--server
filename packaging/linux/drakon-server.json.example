{
  "schema_version": "drakon.v1",
  "runtime": {
    "instance_id": "drakon-server-system",
    "data_root": "/var/lib/drakon-server",
    "runtime_root": "/run/drakon-server",
    "config_root": "/etc/drakon-server",
    "log_root": "/var/log/drakon-server",
    "timezone": "America/Manaus",
    "api": {
      "enabled": false,
      "bind_address": "127.0.0.1",
      "port": 8077
    }
  },
  "database": {
    "type": "sqlite",
    "path": "/var/lib/drakon-server/db/drakon-server.sqlite3",
    "sqlite": {
      "enabled": true,
      "path": "/var/lib/drakon-server/db/drakon-server.sqlite3"
    },
    "postgres": {
      "enabled": false,
      "connection_string_ref": "env:DRAKON_POSTGRES_DSN"
    }
  },
  "capture": {
    "enabled": false,
    "profiles": [
      {
        "profile_id": "fps_1",
        "fps": 1,
        "enabled": true,
        "image_format": "jpg",
        "quality": 90
      },
      {
        "profile_id": "fps_10",
        "fps": 10,
        "enabled": false,
        "image_format": "jpg",
        "quality": 85
      }
    ],
    "frame_store": {
      "enabled": true,
      "write_metadata_sidecar": true,
      "checksum": "sha256",
      "atomic_writes": true
    }
  },
  "inference": {
    "enabled": false,
    "provider": "disabled",
    "model": "mock-frame-analyzer-v1",
    "api_key_ref": null,
    "prompt_id": "default_frame_analysis",
    "prompt_version": "v1",
    "prompt_template": "Analyze the frame and return structured JSON with objects, events, risk_score and alert_candidates.",
    "allow_raw_response": false,
    "providers": [
      {
        "provider": "mock",
        "enabled": false,
        "model": "mock-frame-analyzer-v1"
      }
    ]
  },
  "alerts": {
    "enabled": true,
    "dedupe_window_seconds": 300,
    "channels": [],
    "webhooks": []
  },
  "security": {
    "secrets_provider": "env",
    "allow_inline_secrets": false,
    "redact_logs": true
  },
  "cameras": []
}
