# Example environment file for the drakon-server systemd service.
# Install as /etc/drakon-server/drakon-server.env and keep real secrets out of
# packages, repositories and logs.

DRAKON_CONFIG=/etc/drakon-server/drakon-server.json
DRAKON_LOG_LEVEL=info

# Optional secret references used by config JSON values such as env:OPENAI_API_KEY.
# Do not fill real values in this example file.
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# DRAKON_POSTGRES_DSN=
# DRAKON_WEBHOOK_URL=
# DRAKON_WEBHOOK_SECRET=
# DRAKON_RTSP_CAMERA_01_URL=
